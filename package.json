{
	"name": "nprush",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:relative": "vite build --base=./",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest --project server",
		"test": "vitest run --project server",
		"test:browser": "vitest run --project client",
		"test:e2e": "playwright test",
		"test:all": "vitest run --project server && vitest run --project client"
	},
	"dependencies": {
		"@vaie/hui": "^0.2.1",
		"wgpu-matrix": "^3.4.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.65.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@vitest/browser-playwright": "^4.1.8",
		"@webgpu/types": "^0.1.70",
		"playwright": "^1.60.0",
		"sass": "^1.101.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	}
}
