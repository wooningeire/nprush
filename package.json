{
	"name": "nprush",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:relative": "vite build --base=./",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest --project server",
		"test": "vitest run --project server",
		"test:browser": "vitest run --project client",
		"test:e2e": "playwright test",
		"test:all": "vitest run --project server && vitest run --project client"
	},
	"dependencies": {
		"@vaie/hui": "^0.3.0",
		"wgpu-matrix": "^3.4.2"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@vitest/browser-playwright": "^5.0.5",
		"@webgpu/types": "^0.1.74",
		"playwright": "^1.64.1",
		"sass": "^1.106.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	}
}
